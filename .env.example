# Copy to .env and fill in. Never commit .env.
# Etsy "keystring:shared secret" of your app, as shown in the developer portal
ETSY_API_KEY=
# Exact HTTPS redirect URI registered with the app (see docs/redirect/)
ETSY_REDIRECT_URI=
# Optional; looked up automatically when empty
ETSY_SHOP_ID=
# Written by `login` and by automatic refresh — do not edit by hand
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_TOKEN_EXPIRES_AT=
